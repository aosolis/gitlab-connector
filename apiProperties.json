{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "oauth2generic",
          "clientId": "cb0d2dc33a6e4527a2a30462dd38f44c6b5279a5566258f0fe580d2063c15eeb",
          "scopes": [
            "api"
          ],
          "redirectMode": "Global",
          "redirectUrl": "https://global.consent.azure-apim.net/redirect",
          "properties": {
            "IsFirstParty": "False",
            "AzureActiveDirectoryResourceId": "",
            "IsOnbehalfofLoginSupported": false
          },
          "customParameters": {
            "authorizationUrlTemplate": {
              "value": "https://gitlab.com/oauth/authorize"
            },
            "tokenUrlTemplate": {
              "value": "https://gitlab.com/oauth/token"
            },
            "refreshUrlTemplate": {
              "value": "https://gitlab.com/oauth/token"
            }
          }
        }
      },
      "gitlabHost": {
        "type": "string",
        "uiDefinition": {
          "displayName": "GitLab host",
          "description": "GitLab host name without scheme, for example gitlab.com or gitlab.mycompany.com.",
          "tooltip": "Enter the GitLab host, e.g. gitlab.com",
          "constraints": {
            "required": "true"
          }
        }
      }
    },
    "iconBrandColor": "#FC6D26",
    "capabilities": [
      "actions"
    ],
    "scriptOperations": [
      "OnPushEvent",
      "OnTagPushEvent",
      "OnIssueEvent",
      "OnMergeRequestEvent",
      "OnNoteEvent",
      "OnPipelineEvent",
      "OnJobEvent",
      "OnWikiPageEvent",
      "OnDeploymentEvent",
      "OnReleaseEvent",
      "OnMilestoneEvent",
      "OnFeatureFlagEvent",
      "OnAccessTokenEvent"
    ],
    "policyTemplateInstances": [
      {
        "templateId": "dynamichosturl",
        "title": "Route requests to the GitLab host",
        "parameters": {
          "x-ms-apimTemplateParameter.urlTemplate": "https://@connectionParameters('gitlabHost')/api/v4"
        }
      },
      {
        "templateId": "routerequesttoendpoint",
        "title": "Route webhook triggers to the create-hook endpoint",
        "parameters": {
          "x-ms-apimTemplateParameter.newPath": "/projects/{id}/hooks",
          "x-ms-apimTemplateParameter.httpMethod": "@Request.OriginalHTTPMethod",
          "x-ms-apimTemplate-operationName": [
            "OnPushEvent",
            "OnTagPushEvent",
            "OnIssueEvent",
            "OnMergeRequestEvent",
            "OnNoteEvent",
            "OnPipelineEvent",
            "OnJobEvent",
            "OnWikiPageEvent",
            "OnDeploymentEvent",
            "OnReleaseEvent",
            "OnMilestoneEvent",
            "OnFeatureFlagEvent",
            "OnAccessTokenEvent"
          ]
        }
      }
    ],
    "publisher": "GitLab Connector",
    "stackOwner": "GitLab"
  }
}
