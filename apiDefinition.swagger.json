          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "put": {
        "operationId": "UpdateIssue",
        "summary": "Update issue",
        "description": "Updates an existing project issue.",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/IssueIid"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateIssueRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The updated issue.",
            "schema": {
              "$ref": "#/definitions/Issue"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/projects/{id}/issues/{issue_iid}/notes": {
      "post": {
        "operationId": "AddIssueComment",
        "summary": "Add comment to issue",
        "description": "Adds a note (comment) to a project issue.",
