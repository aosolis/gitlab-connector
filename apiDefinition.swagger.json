{
  "swagger": "2.0",
  "info": {
    "title": "GitLab",
    "description": "Connect to GitLab (SaaS gitlab.com or a self-managed instance) to manage projects, issues, merge requests, pipelines, and comments.",
    "version": "1.0.0",
    "contact": {
      "name": "GitLab Connector",
      "url": "https://docs.gitlab.com/ee/api/"
    }
  },
  "host": "gitlab.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/user": {
      "get": {
        "operationId": "GetCurrentUser",
        "summary": "Get current user",
        "description": "Gets the profile of the authenticated user.",
        "responses": {
          "200": {
            "description": "The authenticated user.",
            "schema": {
              "$ref": "#/definitions/User"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "ListProjects",
        "summary": "List projects",
        "description": "Lists projects that the authenticated user can access.",
        "parameters": [
          {
            "name": "membership",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": true,
            "description": "Limit to projects the current user is a member of.",
            "x-ms-summary": "Member projects only"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Return projects matching the search term.",
            "x-ms-summary": "Search"
          },
          {
            "name": "order_by",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "id",
              "name",
              "path",
              "created_at",
              "updated_at",
              "last_activity_at"
            ],
            "default": "last_activity_at",
            "description": "Field to order results by.",
            "x-ms-summary": "Order by"
          },
          {
            "$ref": "#/parameters/PerPage"
          },
          {
            "$ref": "#/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of projects.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Project"
              }
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/projects/{id}": {
      "get": {
        "operationId": "GetProject",
        "summary": "Get project",
        "description": "Gets a single project by numeric ID or URL-encoded path (group/project).",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "The project.",
            "schema": {
              "$ref": "#/definitions/Project"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/projects/{id}/issues": {
      "get": {
        "operationId": "ListIssues",
        "summary": "List issues",
        "description": "Lists issues for a project.",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "opened",
              "closed",
              "all"
            ],
            "default": "opened",
            "description": "Return issues in the given state.",
            "x-ms-summary": "State"
          },
          {
            "name": "labels",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Comma-separated list of label names.",
            "x-ms-summary": "Labels"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Search issues by title and description.",
            "x-ms-summary": "Search"
          },
          {
            "$ref": "#/parameters/PerPage"
          },
          {
            "$ref": "#/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of issues.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Issue"
              }
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "post": {
        "operationId": "CreateIssue",
        "summary": "Create issue",
        "description": "Creates a new issue in a project.",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateIssueRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The created issue.",
            "schema": {
              "$ref": "#/definitions/Issue"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/projects/{id}/issues/{issue_iid}": {
      "get": {
        "operationId": "GetIssue",
        "summary": "Get issue",
        "description": "Gets a single project issue by its internal ID (IID).",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/IssueIid"
          }
        ],
        "responses": {
          "200": {
            "description": "The issue.",
